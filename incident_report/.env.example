# Copy this file to .env (it is bundled as a Flutter asset, so the file must exist).
# NEVER commit .env.

# Openinary API key (rotate it in your Openinary dashboard if it was ever shared).
openinary_key=

# Optional: override the Firebase API keys baked into lib/firebase_options.dart.
# Leave these lines out unless you need to; an empty value would override the default.
# firebase_web=
# firebase_android=
# firebase_ios=
# firebase_mac=
# firebase_window=
